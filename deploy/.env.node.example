# ── Node Identity ─────────────────────────────────────────────────
# Unique ID for this hub (e.g., hub-air, hub-mini)
HUB_ID=hub-air

# ── Solana ────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# ── Databases (local Docker containers) ──────────────────────────
HUB_DATABASE_URL=postgresql://tribe:tribe@localhost:5436/tribe_hub
ER_DATABASE_URL=postgresql://tribe:tribe@localhost:5435/tribe_er

# ── Peer Hub (the OTHER node's gossip endpoint) ──────────────────
# If this is Node A, point to Node B and vice versa
PEER_HUB_URL=wss://hub-b.yourdomain.com/gossip

# ── ER Server ─────────────────────────────────────────────────────
# Path to the server wallet keypair (same file on both nodes)
SERVER_WALLET_PATH=./server-wallet.json
SETTLEMENT_INTERVAL_MS=10000

# ── Cloudflare Tunnel ─────────────────────────────────────────────
# Your domain name
DOMAIN=yourdomain.com
# This node's subdomain prefix (e.g., hub-a, hub-b)
NODE_PREFIX=hub-a

# ── Program IDs (devnet) ──────────────────────────────────────────
TID_REGISTRY_PROGRAM_ID=4BSmJmRGQWKgioP9DG2bUuRS9U3V6soRauU7Nv6yGvHD
APP_KEY_REGISTRY_PROGRAM_ID=5LtbFUeAoXWRovGpyWnRJhiCS62XsTYKVErT9kPpv4hN
SOCIAL_GRAPH_PROGRAM_ID=8kKnWvbmTjWq5uPePk79RRbQMAXCszNFzHdRwUS4N74w
