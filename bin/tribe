#!/bin/bash
#
# tribe - CLI for managing the TribeEco decentralized social protocol
#
# Usage:
#   tribe start       Start all services (databases, backend, frontend)
#   tribe stop        Stop all services
#   tribe status      Show status of all services
#   tribe logs [svc]  Tail logs (hub | er-server | app | all)
#   tribe tunnel      Show active Cloudflare tunnel URLs
#   tribe doctor      Check prerequisites and system health
#   tribe reset       Stop services and remove volumes (fresh start)
#   tribe version     Show version info
#   tribe help        Show this help message

set -e

VERSION="0.1.0"

# ── Resolve TRIBE_HOME ──────────────────────────────────────────────
# If installed via brew, TRIBE_HOME is set by the formula wrapper.
# Otherwise, resolve from this script's location.
if [ -z "$TRIBE_HOME" ]; then
  SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
  # If bin/tribe, go up one level
  if [ "$(basename "$SCRIPT_DIR")" = "bin" ]; then
    TRIBE_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"
  else
    TRIBE_HOME="$SCRIPT_DIR"
  fi
fi

LOG_DIR="$TRIBE_HOME/.logs"
TUNNEL_DIR="$TRIBE_HOME/.tunnels"
COMPOSE_FILE="$TRIBE_HOME/docker-compose.yml"

# ── Colors ───────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

ok()   { echo -e "  ${GREEN}✔${NC} $1"; }
warn() { echo -e "  ${YELLOW}!${NC} $1"; }
fail() { echo -e "  ${RED}✘${NC} $1"; }
info() { echo -e "  ${CYAN}→${NC} $1"; }

# ── Commands ─────────────────────────────────────────────────────────

cmd_version() {
  echo "tribe $VERSION"
  echo "TribeEco - Decentralized Social Protocol on Solana"
  echo "Home: $TRIBE_HOME"
}

cmd_help() {
  echo ""
  echo -e "${BOLD}tribe${NC} - manage the TribeEco stack"
  echo ""
  echo -e "${BOLD}USAGE${NC}"
  echo "  tribe <command> [options]"
  echo ""
  echo -e "${BOLD}COMMANDS${NC}"
  echo "  start        Start all services (databases, backend, frontend)"
  echo "  stop         Stop all running services"
  echo "  status       Show status of all services"
  echo "  logs [svc]   Tail logs: hub, er-server, app, or all (default)"
  echo "  tunnel       Show active Cloudflare tunnel URLs"
  echo "  doctor       Check prerequisites and system health"
  echo "  reset        Stop services and wipe database volumes"
  echo "  version      Show version info"
  echo "  help         Show this help message"
  echo ""
  echo -e "${BOLD}SERVICES${NC}"
  echo "  Frontend app     http://localhost:3002"
  echo "  Hub API          http://localhost:4000"
  echo "  ER server        http://localhost:3003"
  echo ""
  echo -e "${BOLD}EXAMPLES${NC}"
  echo "  tribe start          # boot everything"
  echo "  tribe logs hub       # tail hub logs"
  echo "  tribe status         # check what's running"
  echo "  tribe stop           # shut it all down"
  echo ""
}

cmd_doctor() {
  echo ""
  echo -e "${CYAN}==> Running diagnostics...${NC}"
  echo ""

  ISSUES=0

  # Docker
  if ! command -v docker &>/dev/null; then
    fail "docker not found — install: https://docs.docker.com/get-docker/"
    ISSUES=$((ISSUES+1))
  else
    ok "docker $(docker --version | sed 's/Docker version //' | cut -d, -f1)"
  fi

  # Docker Compose
  if ! command -v docker-compose &>/dev/null && ! docker compose version &>/dev/null 2>&1; then
    fail "docker-compose not found — install: https://docs.docker.com/compose/install/"
    ISSUES=$((ISSUES+1))
  else
    ok "docker-compose available"
  fi

  # Docker daemon
  if ! docker info &>/dev/null 2>&1; then
    fail "Docker daemon not running — start Docker Desktop or 'colima start'"
    ISSUES=$((ISSUES+1))
  else
    ok "Docker daemon running"
  fi

  # Node.js
  if ! command -v node &>/dev/null; then
    fail "node not found — install: brew install node"
    ISSUES=$((ISSUES+1))
  else
    ok "node $(node --version)"
  fi

  # pnpm
  if ! command -v pnpm &>/dev/null; then
    fail "pnpm not found — install: brew install pnpm"
    ISSUES=$((ISSUES+1))
  else
    ok "pnpm $(pnpm --version)"
  fi

  # Project files
  for svc in tribe-app tribe-er-server tribe-hub tribe-protocol tribe-sdk; do
    if [ -d "$TRIBE_HOME/$svc" ]; then
      ok "$svc directory present"
    else
      fail "$svc directory missing"
      ISSUES=$((ISSUES+1))
    fi
  done

  # ER server wallet — auto-generate if missing, persist to ~/.tribe/
  PERSISTENT_WALLET="$HOME/.tribe/server-wallet.json"
  INSTALL_WALLET="$TRIBE_HOME/tribe-er-server/server-wallet.json"

  if [ -f "$INSTALL_WALLET" ]; then
    if [ ! -f "$PERSISTENT_WALLET" ]; then
      mkdir -p "$HOME/.tribe"
      cp "$INSTALL_WALLET" "$PERSISTENT_WALLET"
    fi
    ok "ER server wallet present"
  elif [ -f "$PERSISTENT_WALLET" ]; then
    cp "$PERSISTENT_WALLET" "$INSTALL_WALLET"
    ok "ER server wallet restored from ~/.tribe/"
  elif command -v solana-keygen &>/dev/null; then
    mkdir -p "$HOME/.tribe"
    solana-keygen new -o "$INSTALL_WALLET" --no-bip39-passphrase 2>/dev/null
    cp "$INSTALL_WALLET" "$PERSISTENT_WALLET"
    ok "ER server wallet generated (backed up to ~/.tribe/)"
  else
    fail "tribe-er-server/server-wallet.json missing"
    ISSUES=$((ISSUES+1))
  fi

  # Ports
  echo ""
  echo -e "${CYAN}  Port availability:${NC}"
  for entry in "3002:frontend" "3003:er-server" "4000:hub" "5435:er-db" "5436:hub-db"; do
    PORT="${entry%%:*}"
    NAME="${entry##*:}"
    if lsof -i :"$PORT" -sTCP:LISTEN &>/dev/null 2>&1; then
      warn "Port $PORT ($NAME) in use"
    else
      ok "Port $PORT ($NAME) free"
    fi
  done

  echo ""
  if [ "$ISSUES" -eq 0 ]; then
    echo -e "  ${GREEN}All checks passed. Ready to run 'tribe start'.${NC}"
  else
    echo -e "  ${RED}$ISSUES issue(s) found. Fix them before running 'tribe start'.${NC}"
  fi
  echo ""
}

start_tunnels() {
  if ! command -v cloudflared &>/dev/null; then
    warn "cloudflared not found — skipping tunnels (brew install cloudflared)"
    return
  fi

  mkdir -p "$TUNNEL_DIR"

  for entry in "3002:frontend" "4000:hub-api" "3003:er-server"; do
    PORT="${entry%%:*}"
    NAME="${entry##*:}"
    LOG_FILE="$TUNNEL_DIR/${NAME}.log"

    cloudflared tunnel --url "http://localhost:${PORT}" > "$LOG_FILE" 2>&1 &
    echo $! > "$TUNNEL_DIR/${NAME}.pid"
  done

  # Wait for tunnel URLs to appear in logs
  sleep 3

  TUNNEL_HUB=""
  TUNNEL_ER=""
  TUNNEL_FRONTEND=""

  for entry in "3002:frontend:TUNNEL_FRONTEND" "4000:hub-api:TUNNEL_HUB" "3003:er-server:TUNNEL_ER"; do
    PORT="${entry%%:*}"
    REST="${entry#*:}"
    NAME="${REST%%:*}"
    VAR="${REST##*:}"
    LOG_FILE="$TUNNEL_DIR/${NAME}.log"

    # Retry a few times to extract the URL
    for attempt in $(seq 1 10); do
      URL=$(grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' "$LOG_FILE" 2>/dev/null | head -1)
      if [ -n "$URL" ]; then
        eval "$VAR=$URL"
        break
      fi
      sleep 1
    done
  done

  # Export for display
  export TUNNEL_HUB TUNNEL_ER TUNNEL_FRONTEND
}

stop_tunnels() {
  if [ -d "$TUNNEL_DIR" ]; then
    for pidfile in "$TUNNEL_DIR"/*.pid; do
      [ -f "$pidfile" ] || continue
      PID=$(cat "$pidfile")
      if kill -0 "$PID" 2>/dev/null; then
        kill "$PID" 2>/dev/null
      fi
      rm -f "$pidfile"
    done
    rm -f "$TUNNEL_DIR"/*.log
  fi
}

cmd_tunnel() {
  echo ""
  if [ -d "$TUNNEL_DIR" ] && ls "$TUNNEL_DIR"/*.pid &>/dev/null 2>&1; then
    echo -e "${BOLD}Active tunnels:${NC}"
    echo ""
    for entry in "frontend:3002" "hub-api:4000" "er-server:3003"; do
      NAME="${entry%%:*}"
      PORT="${entry##*:}"
      LOG_FILE="$TUNNEL_DIR/${NAME}.log"
      URL=$(grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' "$LOG_FILE" 2>/dev/null | head -1)
      if [ -n "$URL" ]; then
        ok "$(printf '%-14s' "$NAME") → $URL"
      else
        fail "$(printf '%-14s' "$NAME") tunnel not ready"
      fi
    done
  else
    echo -e "  No active tunnels. Run ${CYAN}tribe start${NC} to create them."
  fi
  echo ""
}

cmd_start() {
  # Run doctor checks first
  echo ""
  echo -e "${CYAN}╔══════════════════════════════════════════════╗${NC}"
  echo -e "${CYAN}║          TribeEco - Starting Up              ║${NC}"
  echo -e "${CYAN}║   Decentralized Social Protocol on Solana    ║${NC}"
  echo -e "${CYAN}╚══════════════════════════════════════════════╝${NC}"
  echo ""

  echo "==> Checking prerequisites..."

  MISSING=0

  # Docker CLI
  if ! command -v docker &>/dev/null; then
    fail "docker not found"; MISSING=1
  else
    ok "docker found ($(docker --version | head -1))"
  fi

  # Docker Compose
  if ! command -v docker-compose &>/dev/null && ! docker compose version &>/dev/null 2>&1; then
    fail "docker-compose not found"; MISSING=1
  else
    ok "docker-compose found"
  fi

  # Docker daemon
  if ! docker info &>/dev/null 2>&1; then
    if command -v colima &>/dev/null; then
      warn "Docker daemon not running. Starting Colima..."
      colima start
      if ! docker info &>/dev/null 2>&1; then
        fail "Colima started but Docker daemon still unreachable."; MISSING=1
      else
        ok "Colima started successfully"
      fi
    else
      fail "Docker daemon not running. Start Docker Desktop or 'colima start'."; MISSING=1
    fi
  else
    ok "Docker daemon running"
  fi

  # Node.js
  if ! command -v node &>/dev/null; then
    fail "node not found"; MISSING=1
  else
    ok "node $(node --version)"
  fi

  # pnpm
  if ! command -v pnpm &>/dev/null; then
    fail "pnpm not found"; MISSING=1
  else
    ok "pnpm $(pnpm --version)"
  fi

  # Dependencies
  if [ ! -d "$TRIBE_HOME/tribe-app/node_modules" ]; then
    warn "Installing tribe-app dependencies..."
    (cd "$TRIBE_HOME/tribe-app" && pnpm install) || { fail "pnpm install failed"; MISSING=1; }
    ok "tribe-app dependencies installed"
  else
    ok "tribe-app dependencies present"
  fi

  # Required directories
  for svc in tribe-er-server tribe-hub; do
    if [ ! -d "$TRIBE_HOME/$svc" ]; then
      fail "$svc directory missing"; MISSING=1
    else
      ok "$svc directory present"
    fi
  done

  # ER server wallet — auto-generate if missing, persist to ~/.tribe/
  PERSISTENT_WALLET="$HOME/.tribe/server-wallet.json"
  INSTALL_WALLET="$TRIBE_HOME/tribe-er-server/server-wallet.json"

  if [ ! -f "$INSTALL_WALLET" ]; then
    if [ -f "$PERSISTENT_WALLET" ]; then
      info "Restoring ER server wallet from ~/.tribe/"
      cp "$PERSISTENT_WALLET" "$INSTALL_WALLET"
      ok "ER server wallet restored"
    elif command -v solana-keygen &>/dev/null; then
      info "Generating ER server wallet..."
      mkdir -p "$HOME/.tribe"
      solana-keygen new -o "$INSTALL_WALLET" --no-bip39-passphrase 2>/dev/null
      cp "$INSTALL_WALLET" "$PERSISTENT_WALLET"
      ok "ER server wallet generated (backed up to ~/.tribe/)"
    else
      fail "tribe-er-server/server-wallet.json missing (install solana-cli to auto-generate)"; MISSING=1
    fi
  else
    # Ensure persistent backup exists
    if [ ! -f "$PERSISTENT_WALLET" ]; then
      mkdir -p "$HOME/.tribe"
      cp "$INSTALL_WALLET" "$PERSISTENT_WALLET"
    fi
    ok "ER server wallet present"
  fi

  # Ports
  for entry in "3002:frontend" "3003:er-server" "4000:hub" "5435:er-db" "5436:hub-db"; do
    PORT="${entry%%:*}"
    NAME="${entry##*:}"
    if lsof -i :"$PORT" -sTCP:LISTEN &>/dev/null 2>&1; then
      warn "Port $PORT ($NAME) already in use"
    else
      ok "Port $PORT ($NAME) available"
    fi
  done

  echo ""

  if [ "$MISSING" -ne 0 ]; then
    echo -e "${RED}==> Prerequisites missing. Run 'tribe doctor' for details.${NC}"
    exit 1
  fi

  echo -e "${GREEN}==> All prerequisites met. Starting TribeEco...${NC}"
  echo ""

  mkdir -p "$LOG_DIR"

  # 1. Docker services
  echo "[1/4] Building and starting Docker services..."
  info "Building images (first run takes a minute)..."
  docker-compose -f "$COMPOSE_FILE" up -d --build 2>&1 | while read line; do
    echo "       $line"
  done

  # 2. Database health
  echo "[2/4] Waiting for databases..."
  for i in $(seq 1 30); do
    ALL_HEALTHY=1
    for svc in er-db hub-db; do
      STATUS=$(docker-compose -f "$COMPOSE_FILE" ps "$svc" --format json 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin).get('Health',''))" 2>/dev/null || echo "")
      if [ "$STATUS" != "healthy" ]; then ALL_HEALTHY=0; fi
    done
    if [ "$ALL_HEALTHY" -eq 1 ]; then break; fi
    printf "\r       Waiting for databases... (%ds)" "$i"
    sleep 1
  done
  echo ""
  ok "Databases ready"

  # 3. Backend health
  echo "[3/4] Waiting for backend services..."
  wait_for_service() {
    local name=$1 url=$2 max_wait=$3
    for i in $(seq 1 $max_wait); do
      if curl -sf "$url" > /dev/null 2>&1; then
        ok "$name is healthy"; return 0
      fi
      sleep 1
    done
    warn "$name did not become healthy in ${max_wait}s (may still be starting)"
  }
  wait_for_service "Hub" "http://localhost:4000/health" 30
  wait_for_service "ER server" "http://localhost:3003/health" 30

  # 4. Frontend
  echo "[4/4] Starting frontend app (Next.js on port 3002)..."
  cd "$TRIBE_HOME/tribe-app"
  pnpm dev -p 3002 > "$LOG_DIR/tribe-app.log" 2>&1 &
  echo $! > "$LOG_DIR/tribe-app.pid"

  for i in $(seq 1 20); do
    if curl -sf "http://localhost:3002" > /dev/null 2>&1; then break; fi
    sleep 1
  done

  # 5. Start Cloudflare tunnels
  echo "[5/5] Starting Cloudflare tunnels..."
  start_tunnels

  # Detect local network IP
  LOCAL_IP=$(ipconfig getifaddr en0 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}' || echo "")

  echo ""
  echo -e "${GREEN}╔══════════════════════════════════════════════╗${NC}"
  echo -e "${GREEN}║          TribeEco is running!                ║${NC}"
  echo -e "${GREEN}╚══════════════════════════════════════════════╝${NC}"
  echo ""
  echo -e "  ${BOLD}Local access:${NC}"
  echo -e "    ${CYAN}Frontend app:${NC}   http://localhost:3002"
  echo -e "    ${CYAN}Hub API:${NC}        http://localhost:4000"
  echo -e "    ${CYAN}ER server:${NC}      http://localhost:3003"
  if [ -n "$LOCAL_IP" ]; then
    echo ""
    echo -e "  ${BOLD}Network access (use from other devices):${NC}"
    echo -e "    ${CYAN}Frontend app:${NC}   http://${LOCAL_IP}:3002"
    echo -e "    ${CYAN}Hub API:${NC}        http://${LOCAL_IP}:4000"
    echo -e "    ${CYAN}ER server:${NC}      http://${LOCAL_IP}:3003"
  fi
  if [ -n "$TUNNEL_FRONTEND" ] || [ -n "$TUNNEL_HUB" ] || [ -n "$TUNNEL_ER" ]; then
    echo ""
    echo -e "  ${BOLD}Public tunnel access (share with anyone):${NC}"
    [ -n "$TUNNEL_FRONTEND" ] && echo -e "    ${CYAN}Frontend app:${NC}   $TUNNEL_FRONTEND"
    [ -n "$TUNNEL_HUB" ]      && echo -e "    ${CYAN}Hub API:${NC}        $TUNNEL_HUB"
    [ -n "$TUNNEL_ER" ]       && echo -e "    ${CYAN}ER server:${NC}      $TUNNEL_ER"
  fi
  echo ""
  echo -e "    ${CYAN}Network:${NC}        Solana Devnet"
  echo -e "    ${CYAN}App logs:${NC}       tribe logs app"
  echo -e "    ${CYAN}Docker logs:${NC}    tribe logs hub"
  echo -e "    ${CYAN}Tunnels:${NC}        tribe tunnel"
  echo -e "    ${CYAN}Stop with:${NC}      tribe stop"
  echo ""
  echo -e "    ${YELLOW}Tip:${NC} Install Phantom wallet extension to connect."
  echo ""
}

cmd_stop() {
  echo ""
  echo -e "${CYAN}==> Stopping TribeEco...${NC}"

  # Frontend
  if [ -f "$LOG_DIR/tribe-app.pid" ]; then
    PID=$(cat "$LOG_DIR/tribe-app.pid")
    if kill -0 "$PID" 2>/dev/null; then
      echo "  [1/3] Stopping frontend app (PID $PID)..."
      kill "$PID" 2>/dev/null
      wait "$PID" 2>/dev/null || true
    else
      echo "  [1/3] Frontend app already stopped."
    fi
    rm -f "$LOG_DIR/tribe-app.pid"
  else
    echo "  [1/3] No frontend PID found."
  fi

  # Tunnels
  echo "  [2/3] Stopping Cloudflare tunnels..."
  stop_tunnels

  # Docker
  echo "  [3/3] Stopping Docker services..."
  docker-compose -f "$COMPOSE_FILE" down

  echo ""
  echo -e "${GREEN}==> TribeEco stopped.${NC}"
  echo ""
}

cmd_status() {
  echo ""
  echo -e "${BOLD}TribeEco service status${NC}"
  echo ""

  # Frontend
  if [ -f "$LOG_DIR/tribe-app.pid" ] && kill -0 "$(cat "$LOG_DIR/tribe-app.pid")" 2>/dev/null; then
    if curl -sf "http://localhost:3002" > /dev/null 2>&1; then
      ok "Frontend app       running   http://localhost:3002"
    else
      warn "Frontend app       starting  http://localhost:3002"
    fi
  else
    fail "Frontend app       stopped"
  fi

  # Docker services
  for entry in "hub:Hub API:4000" "er-server:ER server:3003" "er-db:ER database:5435" "hub-db:Hub database:5436"; do
    SVC="${entry%%:*}"
    REST="${entry#*:}"
    NAME="${REST%%:*}"
    PORT="${REST##*:}"

    RUNNING=$(docker-compose -f "$COMPOSE_FILE" ps --status running "$SVC" 2>/dev/null | tail -n +2)
    if [ -n "$RUNNING" ]; then
      ok "$(printf '%-18s' "$NAME") running   port $PORT"
    else
      fail "$(printf '%-18s' "$NAME") stopped"
    fi
  done

  echo ""
}

cmd_logs() {
  local target="${1:-all}"
  case "$target" in
    app|frontend)
      if [ -f "$LOG_DIR/tribe-app.log" ]; then
        tail -f "$LOG_DIR/tribe-app.log"
      else
        echo "No app logs found. Is the frontend running?"
      fi
      ;;
    hub)
      docker-compose -f "$COMPOSE_FILE" logs -f hub
      ;;
    er-server|er)
      docker-compose -f "$COMPOSE_FILE" logs -f er-server
      ;;
    all)
      docker-compose -f "$COMPOSE_FILE" logs -f
      ;;
    *)
      echo "Unknown service: $target"
      echo "Usage: tribe logs [app|hub|er-server|all]"
      exit 1
      ;;
  esac
}

cmd_reset() {
  echo ""
  echo -e "${YELLOW}==> This will stop all services and delete database volumes.${NC}"
  read -p "    Continue? [y/N] " -n 1 -r
  echo ""
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Aborted."
    exit 0
  fi

  cmd_stop
  echo "  Removing Docker volumes..."
  docker-compose -f "$COMPOSE_FILE" down -v
  echo ""
  echo -e "${GREEN}==> Reset complete. Run 'tribe start' for a fresh start.${NC}"
  echo ""
}

# ── Main dispatch ────────────────────────────────────────────────────

COMMAND="${1:-help}"
shift 2>/dev/null || true

case "$COMMAND" in
  start)   cmd_start "$@" ;;
  stop)    cmd_stop "$@" ;;
  status)  cmd_status "$@" ;;
  logs)    cmd_logs "$@" ;;
  tunnel)  cmd_tunnel "$@" ;;
  doctor)  cmd_doctor "$@" ;;
  reset)   cmd_reset "$@" ;;
  version) cmd_version "$@" ;;
  help|--help|-h) cmd_help "$@" ;;
  *)
    echo "Unknown command: $COMMAND"
    echo "Run 'tribe help' for usage."
    exit 1
    ;;
esac
