#!/bin/bash
set -uxo pipefail
exec > /var/log/tribe-gcp-setup.log 2>&1

export DOMAIN="${domain}"
export INSTALL_DIR="${install_dir}"
%{ if postgres_password != "" ~}
export POSTGRES_PASSWORD="${postgres_password}"
%{ endif ~}
%{ if hub_id != "" ~}
export HUB_ID="${hub_id}"
%{ endif ~}
%{ if solana_rpc_url != "" ~}
export SOLANA_RPC_URL="${solana_rpc_url}"
%{ endif ~}
%{ if solana_ws_url != "" ~}
export SOLANA_WS_URL="${solana_ws_url}"
%{ endif ~}
%{ if peers != "" ~}
export PEERS="${peers}"
%{ endif ~}

curl -fsSL "${setup_url}" -o /tmp/setup-gcp.sh
bash /tmp/setup-gcp.sh

