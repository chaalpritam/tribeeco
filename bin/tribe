#!/bin/bash
#
# tribe - CLI for managing the TribeEco decentralized social protocol
#
# Usage:
#   tribe start       Start all services (databases, backend, frontend)
#   tribe stop        Stop all services
#   tribe status      Show status of all services
#   tribe logs [svc]  Tail logs (hub | er-server | app | all)
#   tribe seed        Show/set seed node for network auto-connect
#   tribe peers       Show connected hub peers and sync status
#   tribe peer add    Connect to another hub (tribe peer add <url>)
#   tribe network     Show all access URLs (local, LAN, seed)
#   tribe doctor      Check prerequisites and system health
#   tribe reset       Stop services and remove volumes (fresh start)
#   tribe version     Show version info
#   tribe help        Show this help message

set -e

VERSION="0.1.0"

# ── Resolve TRIBE_HOME ──────────────────────────────────────────────
# If installed via brew, TRIBE_HOME is set by the formula wrapper.
# Otherwise, resolve from this script's location.
if [ -z "$TRIBE_HOME" ]; then
  SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
  # If bin/tribe, go up one level
  if [ "$(basename "$SCRIPT_DIR")" = "bin" ]; then
    TRIBE_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"
  else
    TRIBE_HOME="$SCRIPT_DIR"
  fi
fi

LOG_DIR="$TRIBE_HOME/.logs"
COMPOSE_FILE="$TRIBE_HOME/docker-compose.yml"

# ── Colors ───────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

ok()   { echo -e "  ${GREEN}✔${NC} $1"; }
warn() { echo -e "  ${YELLOW}!${NC} $1"; }
fail() { echo -e "  ${RED}✘${NC} $1"; }
info() { echo -e "  ${CYAN}→${NC} $1"; }

# ── Commands ─────────────────────────────────────────────────────────

cmd_version() {
  echo "tribe $VERSION"
  echo "TribeEco - Decentralized Social Protocol on Solana"
  echo "Home: $TRIBE_HOME"
}

cmd_help() {
  echo ""
  echo -e "${BOLD}tribe${NC} - manage the TribeEco stack"
  echo ""
  echo -e "${BOLD}USAGE${NC}"
  echo "  tribe <command> [options]"
  echo ""
  echo -e "${BOLD}COMMANDS${NC}"
  echo "  start        Start all services (databases, backend, frontend)"
  echo "  stop         Stop all running services"
  echo "  status       Show status of all services"
  echo "  logs [svc]   Tail logs: hub, er-server, app, or all (default)"
  echo "  seed         Show/set seed node for network auto-connect"
  echo "  peers        Show connected hub peers"
  echo "  peer add     Connect to another hub: tribe peer add <url>"
  echo "  peer sync    Show sync status with peers"
  echo "  network      Show all access URLs (local, LAN, seed)"
  echo "  share [--qr] Print copy-paste URLs + reachability self-check"
  echo "  link <url>   Point this machine's tribe-app dev server at a remote hub"
  echo "               (use 'link --check <url>' to just probe a remote stack)"
  echo "  doctor       Check prerequisites and system health"
  echo "  reset        Stop services and wipe database volumes"
  echo "  version      Show version info"
  echo "  help         Show this help message"
  echo ""
  echo -e "${BOLD}SERVICES${NC}"
  echo "  Frontend app     http://localhost:3002"
  echo "  Hub API          http://localhost:4000"
  echo "  ER server        http://localhost:3003"
  echo ""
  echo -e "${BOLD}EXAMPLES${NC}"
  echo "  tribe start          # boot everything"
  echo "  tribe logs hub       # tail hub logs"
  echo "  tribe status         # check what's running"
  echo "  tribe stop           # shut it all down"
  echo ""
}

cmd_doctor() {
  echo ""
  echo -e "${CYAN}==> Running diagnostics...${NC}"
  echo ""

  ISSUES=0

  # Docker
  if ! command -v docker &>/dev/null; then
    fail "docker not found — install: https://docs.docker.com/get-docker/"
    ISSUES=$((ISSUES+1))
  else
    ok "docker $(docker --version | sed 's/Docker version //' | cut -d, -f1)"
  fi

  # Docker Compose
  if ! command -v docker-compose &>/dev/null && ! docker compose version &>/dev/null 2>&1; then
    fail "docker-compose not found — install: https://docs.docker.com/compose/install/"
    ISSUES=$((ISSUES+1))
  else
    ok "docker-compose available"
  fi

  # Docker daemon
  if ! docker info &>/dev/null 2>&1; then
    fail "Docker daemon not running — start Docker Desktop or 'colima start'"
    ISSUES=$((ISSUES+1))
  else
    ok "Docker daemon running"
  fi

  # Node.js
  if ! command -v node &>/dev/null; then
    fail "node not found — install: brew install node"
    ISSUES=$((ISSUES+1))
  else
    ok "node $(node --version)"
  fi

  # pnpm
  if ! command -v pnpm &>/dev/null; then
    fail "pnpm not found — install: brew install pnpm"
    ISSUES=$((ISSUES+1))
  else
    ok "pnpm $(pnpm --version)"
  fi

  # Project files
  for svc in tribe-app tribe-er-server tribe-hub tribe-protocol tribe-sdk; do
    if [ -d "$TRIBE_HOME/$svc" ]; then
      ok "$svc directory present"
    else
      fail "$svc directory missing"
      ISSUES=$((ISSUES+1))
    fi
  done

  # ER server wallet — auto-generate if missing, persist to ~/.tribe/
  PERSISTENT_WALLET="$HOME/.tribe/server-wallet.json"
  INSTALL_WALLET="$TRIBE_HOME/tribe-er-server/server-wallet.json"

  if [ -f "$INSTALL_WALLET" ]; then
    if [ ! -f "$PERSISTENT_WALLET" ]; then
      mkdir -p "$HOME/.tribe"
      cp "$INSTALL_WALLET" "$PERSISTENT_WALLET"
    fi
    ok "ER server wallet present"
  elif [ -f "$PERSISTENT_WALLET" ]; then
    cp "$PERSISTENT_WALLET" "$INSTALL_WALLET"
    ok "ER server wallet restored from ~/.tribe/"
  elif command -v solana-keygen &>/dev/null; then
    mkdir -p "$HOME/.tribe"
    solana-keygen new -o "$INSTALL_WALLET" --no-bip39-passphrase 2>/dev/null
    cp "$INSTALL_WALLET" "$PERSISTENT_WALLET"
    ok "ER server wallet generated (backed up to ~/.tribe/)"
  else
    fail "tribe-er-server/server-wallet.json missing"
    ISSUES=$((ISSUES+1))
  fi

  # Ports
  echo ""
  echo -e "${CYAN}  Port availability:${NC}"
  for entry in "3002:frontend" "3003:er-server" "4000:hub" "5435:er-db" "5436:hub-db"; do
    PORT="${entry%%:*}"
    NAME="${entry##*:}"
    if lsof -i :"$PORT" -sTCP:LISTEN &>/dev/null 2>&1; then
      warn "Port $PORT ($NAME) in use"
    else
      ok "Port $PORT ($NAME) free"
    fi
  done

  echo ""
  if [ "$ISSUES" -eq 0 ]; then
    echo -e "  ${GREEN}All checks passed. Ready to run 'tribe start'.${NC}"
  else
    echo -e "  ${RED}$ISSUES issue(s) found. Fix them before running 'tribe start'.${NC}"
  fi
  echo ""
}

show_network_info() {
  local LOCAL_IP="$1"
  local MDNS_HOST="$2"

  echo -e "  ${BOLD}Local access:${NC}"
  echo -e "    ${CYAN}Frontend app:${NC}   http://localhost:3002"
  echo -e "    ${CYAN}Hub API:${NC}        http://localhost:4000"
  echo -e "    ${CYAN}ER server:${NC}      http://localhost:3003"

  if [ -n "$MDNS_HOST" ]; then
    echo ""
    echo -e "  ${BOLD}LAN access via mDNS (works on macOS + iOS):${NC}"
    echo -e "    ${CYAN}Frontend app:${NC}   http://${MDNS_HOST}:3002"
    echo -e "    ${CYAN}Hub API:${NC}        http://${MDNS_HOST}:4000"
    echo -e "    ${CYAN}ER server:${NC}      http://${MDNS_HOST}:3003"
  fi

  if [ -n "$LOCAL_IP" ]; then
    echo ""
    echo -e "  ${BOLD}LAN access via IP (fallback):${NC}"
    echo -e "    ${CYAN}Frontend app:${NC}   http://${LOCAL_IP}:3002"
    echo -e "    ${CYAN}Hub API:${NC}        http://${LOCAL_IP}:4000"
    echo -e "    ${CYAN}ER server:${NC}      http://${LOCAL_IP}:3003"
  fi

  # Seed node info
  SEED_FILE="$HOME/.tribe/seed"
  if [ -f "$SEED_FILE" ]; then
    SEED_URL=$(head -1 "$SEED_FILE" | tr -d '[:space:]')
    SEED_HTTP=$(echo "$SEED_URL" | sed 's|ws://|http://|;s|wss://|https://|;s|/gossip$||')
    echo ""
    echo -e "  ${BOLD}Seed node (public access for apps):${NC}"
    echo -e "    ${CYAN}Hub API:${NC}        $SEED_HTTP"
    echo -e "    ${CYAN}Gossip:${NC}         $SEED_URL"
  else
    echo ""
    echo -e "  ${YELLOW}!${NC} No seed node configured — run ${CYAN}tribe seed set <url>${NC}"
  fi
}

# Resolve the Bonjour-friendly mDNS hostname (e.g. "Chaals-Mac-mini.local").
# Empty string when not on macOS or LocalHostName isn't set. The .local suffix
# is appended so the result is directly usable as a URL host.
detect_mdns_host() {
  local name=""
  if command -v scutil >/dev/null 2>&1; then
    name=$(scutil --get LocalHostName 2>/dev/null || true)
  fi
  if [ -z "$name" ]; then
    # Linux / fallback: try `hostname -s` if avahi is in play
    name=$(hostname -s 2>/dev/null || true)
  fi
  if [ -n "$name" ]; then
    echo "${name}.local"
  fi
}

detect_local_ip() {
  ipconfig getifaddr en0 2>/dev/null \
    || ipconfig getifaddr en1 2>/dev/null \
    || hostname -I 2>/dev/null | awk '{print $1}' \
    || echo ""
}

cmd_network() {
  echo ""
  LOCAL_IP=$(detect_local_ip)
  MDNS_HOST=$(detect_mdns_host)
  show_network_info "$LOCAL_IP" "$MDNS_HOST"
  echo ""
}

# tribe share — prints copy-paste URLs for handing to another device on the
# same Wi-Fi. The hub + ER server are framed as "RPC URLs" because that's
# the typical use case: another laptop runs its own frontend dev server,
# points it at this hub via `tribe link`, and gets a fast local UI talking
# to a remote backend.
#
# Prefers the Bonjour hostname (`*.local`) since it survives DHCP lease
# changes — IP is shown as a fallback for non-Apple clients that can't
# resolve .local.
cmd_share() {
  echo ""
  echo -e "${BOLD}Share this Tribe stack with other devices on this Wi-Fi:${NC}"
  echo ""

  local MDNS_HOST
  MDNS_HOST=$(detect_mdns_host)
  local LOCAL_IP
  LOCAL_IP=$(detect_local_ip)

  local PREFERRED_HOST=""
  if [ -n "$MDNS_HOST" ]; then
    PREFERRED_HOST="$MDNS_HOST"
  elif [ -n "$LOCAL_IP" ]; then
    PREFERRED_HOST="$LOCAL_IP"
  fi

  if [ -z "$PREFERRED_HOST" ]; then
    fail "Could not detect a LAN address. Make sure you're connected to Wi-Fi."
    echo ""
    return 1
  fi

  local FRONTEND_URL="http://${PREFERRED_HOST}:3002"
  local HUB_URL="http://${PREFERRED_HOST}:4000"
  local ER_URL="http://${PREFERRED_HOST}:3003"

  # The .env.local snippet a remote dev frontend pastes in MUST use IPv4,
  # not *.local. macOS publishes the host with both an IPv4 record and an
  # IPv6 link-local fe80:: record; Chrome's fetch() tries the link-local
  # first, can't route it without a scope identifier, and surfaces
  # ERR_ADDRESS_UNREACHABLE without falling back to v4 cleanly. The IP
  # has no dual-stack hazard. Keep the .local hostname elsewhere in the
  # output for ping/curl/CLI use where Happy Eyeballs works correctly.
  local IP_HUB_URL=""
  local IP_ER_URL=""
  local IP_FRONTEND_URL=""
  if [ -n "$LOCAL_IP" ]; then
    IP_HUB_URL="http://${LOCAL_IP}:4000"
    IP_ER_URL="http://${LOCAL_IP}:3003"
    IP_FRONTEND_URL="http://${LOCAL_IP}:3002"
  fi

  local ENV_HUB_URL="${IP_HUB_URL:-$HUB_URL}"
  local ENV_ER_URL="${IP_ER_URL:-$ER_URL}"

  echo -e "  ${BOLD}RPC URLs (point any client at these):${NC}"
  echo -e "    ${CYAN}Hub API:${NC}    ${HUB_URL}"
  echo -e "    ${CYAN}ER server:${NC}  ${ER_URL}"
  echo ""
  echo -e "  ${BOLD}From another laptop's tribe-app checkout — paste into .env.local:${NC}"
  echo "      NEXT_PUBLIC_HUB_URL=${ENV_HUB_URL}"
  echo "      NEXT_PUBLIC_ER_SERVER_URL=${ENV_ER_URL}"
  echo -e "    Then ${CYAN}pnpm dev${NC} in tribe-app/ — that's it. No tribe install needed."
  echo -e "    (If you do have tribe installed there, ${CYAN}tribe link ${ENV_HUB_URL}${NC} writes this for you.)"
  if [ -n "$IP_HUB_URL" ] && [ "$ENV_HUB_URL" != "$HUB_URL" ]; then
    echo -e "    ${YELLOW}Why the IP and not ${MDNS_HOST}?${NC} Browser fetch() trips on macOS' IPv6"
    echo "      link-local record for the .local hostname. The IPv4 has no such issue."
  fi
  echo ""
  echo -e "  ${BOLD}From iPhone / iPad / second browser:${NC}"
  echo -e "    Open this stack's frontend directly:"
  echo -e "      ${CYAN}${FRONTEND_URL}${NC}"
  if [ -n "$IP_FRONTEND_URL" ]; then
    echo -e "    Or via IP if .local doesn't resolve:"
    echo -e "      ${CYAN}${IP_FRONTEND_URL}${NC}"
  fi
  echo ""
  echo -e "  ${BOLD}Native iOS / Android app config:${NC}"
  echo -e "    Hub URL        ${CYAN}${ENV_HUB_URL}${NC}"
  echo -e "    ER server URL  ${CYAN}${ENV_ER_URL}${NC}"
  echo ""

  share_self_check
  echo ""

  if [ "$1" = "--qr" ] || [ "$1" = "-q" ]; then
    if command -v qrencode >/dev/null 2>&1; then
      echo -e "  ${BOLD}Scan to open the web app:${NC}"
      qrencode -t ANSIUTF8 "$FRONTEND_URL"
      echo ""
    else
      warn "qrencode not installed — install via 'brew install qrencode' for QR output"
      echo ""
    fi
  fi
}

# Verify each service is actually listening on 0.0.0.0 (not just localhost).
# A service bound to 127.0.0.1 is unreachable from another device even if
# the URL looks right. Most common cause: stale brew install with an old
# tribe-app submodule whose dev script lacks `-H 0.0.0.0`.
share_self_check() {
  echo -e "  ${BOLD}Reachability check:${NC}"
  share_check_port "Hub API" 4000
  share_check_port "ER server" 3003
  share_check_port "Frontend" 3002

  if [ "$(uname)" = "Darwin" ]; then
    local fw
    fw=$(/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate 2>/dev/null | grep -c "enabled" || echo 0)
    if [ "$fw" -gt 0 ]; then
      warn "macOS firewall is on — if remote access fails, allow Node and Docker in System Settings → Network → Firewall."
    fi
  fi
}

# Returns the addresses a TCP port is listening on. Empty if nothing's
# listening on it.
share_listening_addrs() {
  local port="$1"
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | awk 'NR>1 {print $9}' | sort -u
  fi
}

share_check_port() {
  local label="$1"
  local port="$2"
  local addrs
  addrs=$(share_listening_addrs "$port")
  if [ -z "$addrs" ]; then
    fail "${label} not running on port ${port} — start it with 'tribe start'."
    return
  fi
  if echo "$addrs" | grep -qE '(\*|0\.0\.0\.0|\[::\]):'"$port"; then
    ok "${label} on :${port} bound to all interfaces"
  elif echo "$addrs" | grep -q "127.0.0.1:${port}"; then
    fail "${label} on :${port} is bound to localhost only — other devices can't reach it."
    echo "      Likely a stale tribe-app/. Update with 'brew upgrade tribe' (or"
    echo "      'git -C \$TRIBE_HOME submodule update --remote tribe-app') and restart."
  else
    warn "${label} on :${port} bound to: $(echo "$addrs" | tr '\n' ' ')"
  fi
}

# tribe link <hub-url> — used on the dev machine (MacBook Air) to point
# the local tribe-app at a hub running on a different machine on the same
# Wi-Fi. Writes tribe-app/.env.local with NEXT_PUBLIC_HUB_URL +
# NEXT_PUBLIC_ER_SERVER_URL derived from the hub URL.
cmd_link() {
  local mode="link"
  if [ "${1:-}" = "--check" ] || [ "${1:-}" = "-c" ]; then
    mode="check"
    shift
  fi

  local hub_url="${1:-}"
  if [ -z "$hub_url" ]; then
    echo ""
    fail "Usage: tribe link [--check] <hub-url>"
    echo "  Example: tribe link http://chaals-mac-mini.local:4000"
    echo "           tribe link --check http://chaals-mac-mini.local:4000"
    echo "  (run 'tribe share' on the hub machine to get the URL)"
    echo ""
    exit 1
  fi

  # Strip a trailing slash and any path so we can derive sibling URLs.
  hub_url="${hub_url%/}"
  # Pull out scheme + host (no port) so we can swap port for ER server.
  local host_part
  host_part=$(echo "$hub_url" | sed -E 's|^(https?://)([^/:]+)(:[0-9]+)?.*$|\1\2|')
  if [ -z "$host_part" ]; then
    fail "Could not parse hub URL: $hub_url"
    exit 1
  fi
  local er_url="${host_part}:3003"
  local frontend_url="${host_part}:3002"

  if [ "$mode" = "check" ]; then
    link_check "$hub_url" "$er_url" "$frontend_url"
    return
  fi

  local app_dir="$TRIBE_HOME/tribe-app"
  if [ ! -d "$app_dir" ]; then
    fail "tribe-app submodule missing at $app_dir"
    exit 1
  fi

  local env_file="$app_dir/.env.local"
  cat > "$env_file" <<EOF
# Generated by 'tribe link' — points this dev frontend at a remote hub on
# the same LAN. Re-run 'tribe link <url>' to change targets.
NEXT_PUBLIC_HUB_URL=$hub_url
NEXT_PUBLIC_ER_SERVER_URL=$er_url
EOF

  echo ""
  ok "Wrote $env_file"
  echo -e "  ${CYAN}NEXT_PUBLIC_HUB_URL${NC}        $hub_url"
  echo -e "  ${CYAN}NEXT_PUBLIC_ER_SERVER_URL${NC}  $er_url"
  echo ""

  # Quick reachability check before the user wastes time restarting pnpm dev.
  link_check "$hub_url" "$er_url" "$frontend_url"
  echo ""
  info "Restart 'pnpm dev' in tribe-app/ to pick up the new env."
  info "Then open: http://localhost:3002 — it talks to the remote hub."
  echo ""
}

# Probe a remote stack to see whether it's actually reachable. Useful
# both before linking (to catch firewall/.local issues early) and after,
# so the user knows whether the next pnpm dev will work. Runs three
# checks: hub /health, ER server /health (best-effort), frontend root.
link_check() {
  local hub_url="$1"
  local er_url="$2"
  local frontend_url="$3"

  echo -e "  ${BOLD}Reachability check from this laptop:${NC}"
  LINK_PROBE_UNREACHABLE=0
  link_probe "Hub /health      " "${hub_url}/health"
  link_probe "ER server /health" "${er_url}/health"
  link_probe "Frontend         " "${frontend_url}"
  if [ "$LINK_PROBE_UNREACHABLE" -gt 0 ]; then
    echo ""
    echo "      → Make sure 'tribe start' is running on the hub machine,"
    echo "        that you're on the same Wi-Fi, and that *.local resolves"
    echo "        (try the IP fallback from 'tribe share' on the hub side)."
    echo "      → On macOS, allow incoming connections for Node and Docker"
    echo "        in System Settings → Network → Firewall."
  fi
}

link_probe() {
  local label="$1"
  local url="$2"
  local code
  # curl writes "000" on connection failure; `|| true` keeps `set -e` happy
  # without appending a second 000 from a fallback echo.
  code=$(curl -sS -o /dev/null -w "%{http_code}" --max-time 4 "$url" 2>/dev/null) || true
  [ -z "$code" ] && code="000"
  case "$code" in
    200|301|302|307|308)
      ok "${label}  ${url}  (${code})"
      ;;
    000)
      fail "${label}  ${url}  unreachable"
      LINK_PROBE_UNREACHABLE=$((LINK_PROBE_UNREACHABLE + 1))
      ;;
    *)
      warn "${label}  ${url}  unexpected ${code}"
      ;;
  esac
}

# ── Peer management ─────────────────────────────────────────────────

cmd_peer() {
  local subcmd="${1:-}"
  shift 2>/dev/null || true

  case "$subcmd" in
    add)
      local url="$1"
      if [ -z "$url" ]; then
        echo "Usage: tribe peer add <websocket-url>"
        echo "Example: tribe peer add wss://abc-123.trycloudflare.com/gossip"
        exit 1
      fi
      echo ""
      info "Adding peer: $url"
      RESPONSE=$(curl -sf -X POST http://localhost:4000/v1/peers \
        -H "Content-Type: application/json" \
        -d "{\"url\": \"$url\"}" 2>&1)
      if [ $? -eq 0 ]; then
        ok "Peer added and connection initiated"
        echo "  $RESPONSE" | python3 -m json.tool 2>/dev/null || echo "  $RESPONSE"
      else
        fail "Failed to add peer. Is the hub running?"
      fi
      echo ""
      ;;
    ""|list)
      echo ""
      echo -e "${BOLD}Connected peers:${NC}"
      echo ""
      RESPONSE=$(curl -sf http://localhost:4000/v1/peers 2>&1)
      if [ $? -eq 0 ]; then
        echo "$RESPONSE" | python3 -c "
import sys, json
data = json.load(sys.stdin)
hub_id = data.get('hubId', 'unknown')
peers = data.get('peers', [])
connected = data.get('connectedCount', 0)
print(f'  This hub: {hub_id}')
print(f'  Connected: {connected} peer(s)')
print()
if not peers:
    print('  No peers yet. Add one with: tribe peer add <url>')
for p in peers:
    status = '\033[0;32m●\033[0m' if p.get('connected') else '\033[0;31m●\033[0m'
    hub = p.get('hub_id', 'unknown')
    url = p.get('url', '')
    msgs = p.get('message_count', 0)
    print(f'  {status} {hub}')
    print(f'    URL: {url}')
    print(f'    Messages: {msgs}')
    print()
" 2>/dev/null || echo "  $RESPONSE"
      else
        fail "Failed to fetch peers. Is the hub running?"
      fi
      echo ""
      ;;
    sync)
      echo ""
      echo -e "${BOLD}Sync status:${NC}"
      echo ""
      RESPONSE=$(curl -sf http://localhost:4000/v1/sync/status 2>&1)
      if [ $? -eq 0 ]; then
        echo "$RESPONSE" | python3 -c "
import sys, json
data = json.load(sys.stdin)
syncs = data.get('syncStates', data) if isinstance(data, dict) else data
if not syncs:
    print('  No sync history yet.')
for s in (syncs if isinstance(syncs, list) else []):
    peer = s.get('peer_hub_id', 'unknown')
    last = s.get('last_sync_at', 'never')
    print(f'  {peer}: last synced {last}')
" 2>/dev/null || echo "  $RESPONSE"
      else
        fail "Failed to fetch sync status. Is the hub running?"
      fi
      echo ""
      ;;
    *)
      echo "Usage: tribe peer [add <url> | list | sync]"
      ;;
  esac
}

cmd_peers() {
  cmd_peer list
}

# ── Seed node management ────────────────────────────────────────────

cmd_seed() {
  local subcmd="${1:-show}"
  SEED_FILE="$HOME/.tribe/seed"

  case "$subcmd" in
    set)
      local url="$2"
      if [ -z "$url" ]; then
        echo "Usage: tribe seed set <ws-url>"
        echo "Example: tribe seed set ws://203.0.113.10:4000/gossip"
        exit 1
      fi
      mkdir -p "$HOME/.tribe"
      echo "$url" > "$SEED_FILE"
      ok "Seed node set: $url"
      # If hub is running, connect immediately
      if curl -sf http://localhost:4000/health > /dev/null 2>&1; then
        info "Hub is running, connecting now..."
        curl -sf -X POST http://localhost:4000/v1/peers \
          -H "Content-Type: application/json" \
          -d "{\"url\": \"$url\"}" > /dev/null 2>&1 && ok "Connected to seed node" || warn "Could not connect (will retry on next start)"
      fi
      ;;
    remove)
      rm -f "$SEED_FILE"
      ok "Seed node removed"
      ;;
    show|"")
      echo ""
      if [ -f "$SEED_FILE" ]; then
        echo -e "  ${BOLD}Seed node:${NC} $(cat "$SEED_FILE")"
      else
        echo "  No seed node configured."
        echo ""
        echo "  Set one with:"
        echo -e "    ${CYAN}tribe seed set ws://<PUBLIC_IP>:4000/gossip${NC}"
      fi
      echo ""
      ;;
    *)
      echo "Usage: tribe seed [set <url> | remove | show]"
      ;;
  esac
}

cmd_start() {
  # Run doctor checks first
  echo ""
  echo -e "${CYAN}╔══════════════════════════════════════════════╗${NC}"
  echo -e "${CYAN}║          TribeEco - Starting Up              ║${NC}"
  echo -e "${CYAN}║   Decentralized Social Protocol on Solana    ║${NC}"
  echo -e "${CYAN}╚══════════════════════════════════════════════╝${NC}"
  echo ""

  echo "==> Checking prerequisites..."

  MISSING=0

  # Docker CLI
  if ! command -v docker &>/dev/null; then
    fail "docker not found"; MISSING=1
  else
    ok "docker found ($(docker --version | head -1))"
  fi

  # Docker Compose
  if ! command -v docker-compose &>/dev/null && ! docker compose version &>/dev/null 2>&1; then
    fail "docker-compose not found"; MISSING=1
  else
    ok "docker-compose found"
  fi

  # Docker daemon
  if ! docker info &>/dev/null 2>&1; then
    if command -v colima &>/dev/null; then
      warn "Docker daemon not running. Starting Colima..."
      colima start
      if ! docker info &>/dev/null 2>&1; then
        fail "Colima started but Docker daemon still unreachable."; MISSING=1
      else
        ok "Colima started successfully"
      fi
    else
      fail "Docker daemon not running. Start Docker Desktop or 'colima start'."; MISSING=1
    fi
  else
    ok "Docker daemon running"
  fi

  # Node.js
  if ! command -v node &>/dev/null; then
    fail "node not found"; MISSING=1
  else
    ok "node $(node --version)"
  fi

  # pnpm
  if ! command -v pnpm &>/dev/null; then
    fail "pnpm not found"; MISSING=1
  else
    ok "pnpm $(pnpm --version)"
  fi

  # Dependencies
  if [ ! -d "$TRIBE_HOME/tribe-app/node_modules" ]; then
    warn "Installing tribe-app dependencies..."
    (cd "$TRIBE_HOME/tribe-app" && pnpm install) || { fail "pnpm install failed"; MISSING=1; }
    ok "tribe-app dependencies installed"
  else
    ok "tribe-app dependencies present"
  fi

  # Required directories
  for svc in tribe-er-server tribe-hub; do
    if [ ! -d "$TRIBE_HOME/$svc" ]; then
      fail "$svc directory missing"; MISSING=1
    else
      ok "$svc directory present"
    fi
  done

  # ER server wallet — auto-generate if missing, persist to ~/.tribe/
  PERSISTENT_WALLET="$HOME/.tribe/server-wallet.json"
  INSTALL_WALLET="$TRIBE_HOME/tribe-er-server/server-wallet.json"

  if [ ! -f "$INSTALL_WALLET" ]; then
    if [ -f "$PERSISTENT_WALLET" ]; then
      info "Restoring ER server wallet from ~/.tribe/"
      cp "$PERSISTENT_WALLET" "$INSTALL_WALLET"
      ok "ER server wallet restored"
    elif command -v solana-keygen &>/dev/null; then
      info "Generating ER server wallet..."
      mkdir -p "$HOME/.tribe"
      solana-keygen new -o "$INSTALL_WALLET" --no-bip39-passphrase 2>/dev/null
      cp "$INSTALL_WALLET" "$PERSISTENT_WALLET"
      ok "ER server wallet generated (backed up to ~/.tribe/)"
    else
      fail "tribe-er-server/server-wallet.json missing (install solana-cli to auto-generate)"; MISSING=1
    fi
  else
    # Ensure persistent backup exists
    if [ ! -f "$PERSISTENT_WALLET" ]; then
      mkdir -p "$HOME/.tribe"
      cp "$INSTALL_WALLET" "$PERSISTENT_WALLET"
    fi
    ok "ER server wallet present"
  fi

  # Ports
  for entry in "3002:frontend" "3003:er-server" "4000:hub" "5435:er-db" "5436:hub-db"; do
    PORT="${entry%%:*}"
    NAME="${entry##*:}"
    if lsof -i :"$PORT" -sTCP:LISTEN &>/dev/null 2>&1; then
      warn "Port $PORT ($NAME) already in use"
    else
      ok "Port $PORT ($NAME) available"
    fi
  done

  echo ""

  if [ "$MISSING" -ne 0 ]; then
    echo -e "${RED}==> Prerequisites missing. Run 'tribe doctor' for details.${NC}"
    exit 1
  fi

  echo -e "${GREEN}==> All prerequisites met. Starting TribeEco...${NC}"
  echo ""

  mkdir -p "$LOG_DIR"

  # 1. Docker services
  echo "[1/4] Building and starting Docker services..."
  info "Building images (first run takes a minute)..."
  docker-compose -f "$COMPOSE_FILE" up -d --build 2>&1 | while read line; do
    echo "       $line"
  done

  # 2. Database health
  echo "[2/4] Waiting for databases..."
  for i in $(seq 1 30); do
    ALL_HEALTHY=1
    for svc in er-db hub-db; do
      STATUS=$(docker-compose -f "$COMPOSE_FILE" ps "$svc" --format json 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin).get('Health',''))" 2>/dev/null || echo "")
      if [ "$STATUS" != "healthy" ]; then ALL_HEALTHY=0; fi
    done
    if [ "$ALL_HEALTHY" -eq 1 ]; then break; fi
    printf "\r       Waiting for databases... (%ds)" "$i"
    sleep 1
  done
  echo ""
  ok "Databases ready"

  # 3. Backend health
  echo "[3/4] Waiting for backend services..."
  wait_for_service() {
    local name=$1 url=$2 max_wait=$3
    for i in $(seq 1 $max_wait); do
      if curl -sf "$url" > /dev/null 2>&1; then
        ok "$name is healthy"; return 0
      fi
      sleep 1
    done
    warn "$name did not become healthy in ${max_wait}s (may still be starting)"
  }
  wait_for_service "Hub" "http://localhost:4000/health" 30
  wait_for_service "ER server" "http://localhost:3003/health" 30

  # Auto-connect to seed node if configured
  SEED_FILE="$HOME/.tribe/seed"
  if [ -f "$SEED_FILE" ]; then
    SEED_URL=$(head -1 "$SEED_FILE" | tr -d '[:space:]')
    if [ -n "$SEED_URL" ]; then
      info "Connecting to seed node: $SEED_URL"
      if curl -sf -X POST http://localhost:4000/v1/peers \
        -H "Content-Type: application/json" \
        -d "{\"url\": \"$SEED_URL\"}" > /dev/null 2>&1; then
        ok "Connected to seed node"
      else
        warn "Could not reach seed node (hub will keep retrying)"
      fi
    fi
  fi

  # 4. Frontend
  echo "[4/4] Starting frontend app (Next.js on port 3002)..."
  cd "$TRIBE_HOME/tribe-app"
  pnpm dev -p 3002 > "$LOG_DIR/tribe-app.log" 2>&1 &
  echo $! > "$LOG_DIR/tribe-app.pid"

  for i in $(seq 1 20); do
    if curl -sf "http://localhost:3002" > /dev/null 2>&1; then break; fi
    sleep 1
  done

  # Detect network IPs
  LOCAL_IP=$(ipconfig getifaddr en0 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}' || echo "")

  echo ""
  echo -e "${GREEN}╔══════════════════════════════════════════════╗${NC}"
  echo -e "${GREEN}║          TribeEco is running!                ║${NC}"
  echo -e "${GREEN}╚══════════════════════════════════════════════╝${NC}"
  echo ""
  show_network_info "$LOCAL_IP"
  echo ""
  echo -e "    ${CYAN}Network:${NC}        Solana Devnet"
  echo -e "    ${CYAN}App logs:${NC}       tribe logs app"
  echo -e "    ${CYAN}Docker logs:${NC}    tribe logs hub"
  echo -e "    ${CYAN}Peers:${NC}          tribe peers"
  echo -e "    ${CYAN}All URLs:${NC}       tribe network"
  echo -e "    ${CYAN}Stop with:${NC}      tribe stop"
  echo ""
  echo -e "    ${YELLOW}Tip:${NC} Use ${CYAN}tribe share${NC} to hand this stack to your other devices on Wi-Fi"
  echo -e "         and ${CYAN}tribe peer add <url>${NC} to connect another node"
  echo ""
}

cmd_stop() {
  echo ""
  echo -e "${CYAN}==> Stopping TribeEco...${NC}"

  # Frontend
  if [ -f "$LOG_DIR/tribe-app.pid" ]; then
    PID=$(cat "$LOG_DIR/tribe-app.pid")
    if kill -0 "$PID" 2>/dev/null; then
      echo "  [1/2] Stopping frontend app (PID $PID)..."
      kill "$PID" 2>/dev/null
      wait "$PID" 2>/dev/null || true
    else
      echo "  [1/2] Frontend app already stopped."
    fi
    rm -f "$LOG_DIR/tribe-app.pid"
  else
    echo "  [1/2] No frontend PID found."
  fi

  # Docker
  echo "  [2/2] Stopping Docker services..."
  docker-compose -f "$COMPOSE_FILE" down

  echo ""
  echo -e "${GREEN}==> TribeEco stopped.${NC}"
  echo ""
}

cmd_status() {
  echo ""
  echo -e "${BOLD}TribeEco service status${NC}"
  echo ""

  # Frontend
  if [ -f "$LOG_DIR/tribe-app.pid" ] && kill -0 "$(cat "$LOG_DIR/tribe-app.pid")" 2>/dev/null; then
    if curl -sf "http://localhost:3002" > /dev/null 2>&1; then
      ok "Frontend app       running   http://localhost:3002"
    else
      warn "Frontend app       starting  http://localhost:3002"
    fi
  else
    fail "Frontend app       stopped"
  fi

  # Docker services
  for entry in "hub:Hub API:4000" "er-server:ER server:3003" "er-db:ER database:5435" "hub-db:Hub database:5436"; do
    SVC="${entry%%:*}"
    REST="${entry#*:}"
    NAME="${REST%%:*}"
    PORT="${REST##*:}"

    RUNNING=$(docker-compose -f "$COMPOSE_FILE" ps --status running "$SVC" 2>/dev/null | tail -n +2)
    if [ -n "$RUNNING" ]; then
      ok "$(printf '%-18s' "$NAME") running   port $PORT"
    else
      fail "$(printf '%-18s' "$NAME") stopped"
    fi
  done

  echo ""
}

cmd_logs() {
  local target="${1:-all}"
  case "$target" in
    app|frontend)
      if [ -f "$LOG_DIR/tribe-app.log" ]; then
        tail -f "$LOG_DIR/tribe-app.log"
      else
        echo "No app logs found. Is the frontend running?"
      fi
      ;;
    hub)
      docker-compose -f "$COMPOSE_FILE" logs -f hub
      ;;
    er-server|er)
      docker-compose -f "$COMPOSE_FILE" logs -f er-server
      ;;
    all)
      docker-compose -f "$COMPOSE_FILE" logs -f
      ;;
    *)
      echo "Unknown service: $target"
      echo "Usage: tribe logs [app|hub|er-server|all]"
      exit 1
      ;;
  esac
}

cmd_reset() {
  echo ""
  echo -e "${YELLOW}==> This will stop all services and delete database volumes.${NC}"
  read -p "    Continue? [y/N] " -n 1 -r
  echo ""
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Aborted."
    exit 0
  fi

  cmd_stop
  echo "  Removing Docker volumes..."
  docker-compose -f "$COMPOSE_FILE" down -v
  echo ""
  echo -e "${GREEN}==> Reset complete. Run 'tribe start' for a fresh start.${NC}"
  echo ""
}

# ── Main dispatch ────────────────────────────────────────────────────

COMMAND="${1:-help}"
shift 2>/dev/null || true

case "$COMMAND" in
  start)   cmd_start "$@" ;;
  stop)    cmd_stop "$@" ;;
  status)  cmd_status "$@" ;;
  logs)    cmd_logs "$@" ;;
  seed)    cmd_seed "$@" ;;
  peer)    cmd_peer "$@" ;;
  peers)   cmd_peers "$@" ;;
  network) cmd_network "$@" ;;
  share)   cmd_share "$@" ;;
  link)    cmd_link "$@" ;;
  doctor)  cmd_doctor "$@" ;;
  reset)   cmd_reset "$@" ;;
  version) cmd_version "$@" ;;
  help|--help|-h) cmd_help "$@" ;;
  *)
    echo "Unknown command: $COMMAND"
    echo "Run 'tribe help' for usage."
    exit 1
    ;;
esac
