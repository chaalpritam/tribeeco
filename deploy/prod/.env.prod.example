# Copy to .env in this directory and edit. docker compose reads it
# automatically. DOMAIN can also be passed inline to setup-aws.sh.

# Hostname with a DNS A record pointing at this server's Elastic IP.
DOMAIN=seed.tribeprotocol.xyz

# Gossip mesh id. Must be unique across every peer. The default
# (seed-aws-1) is fine for a single AWS node.
HUB_ID=seed-aws-1

# Postgres password for both databases (not published to the host).
POSTGRES_PASSWORD=change-me

# Solana endpoints. Public devnet is rate-limited; for real traffic use
# a dedicated devnet RPC (Helius / Triton / QuickNode) here.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# Optional: peer with the canonical seed so this node shares its mesh.
# PEERS=wss://seed.tribeapp.wtf/gossip
